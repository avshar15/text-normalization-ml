# ---------------------------------------------------------------
# Data
# The full Kaggle corpus is ~400MB and never belongs in git.
# Everything under data/raw/ is ignored; a small committed sample
# lives at data/sample_en_train.csv so the repo runs out of the box.
# ---------------------------------------------------------------
data/raw/
*.zip

# Allow the committed sample
!data/sample_en_train.csv

# ---------------------------------------------------------------
# Model artifacts and large intermediate outputs
# ---------------------------------------------------------------
*.pkl
*.joblib
*.model
*.npy
*.npz

# ---------------------------------------------------------------
# Secrets. Nothing with a credential in it, ever.
# ---------------------------------------------------------------
.env
.env.local
*.pem
*.key
credentials.json
secrets.yaml

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# ---------------------------------------------------------------
# OS and editor noise
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
